# Environment variable names (values are never committed).
# Copy to .env.local and fill in locally; .env* files other than .env.example are never committed.
# Where each value comes from and where it is set: docs/runbooks/staging.md, "Environment variables".

# --- CMS app (apps/cms; Vercel project litljomi-cms-staging) ---
# Supabase project URL. Public, not secret.
NEXT_PUBLIC_SUPABASE_URL=
# Supabase publishable key. Public, not secret (reaches the browser; RLS and grants protect data).
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Supabase secret key. SECRET. Read only under apps/cms/src/privileged/** and tools/cli.
SUPABASE_SECRET_KEY=
# Internal worker-trigger secret (header x-cms-internal-secret). SECRET.
CMS_INTERNAL_SECRET=
# Vercel Cron secret (Authorization: Bearer). SECRET.
CRON_SECRET=
# Public base URL of the CMS app, e.g. for magic-link redirects. Public, not secret.
CMS_PUBLIC_URL=

# --- Sites (apps/demo-site; the LABAK branch hub-integration) ---
# Public URL of the Supabase Storage `delivery` bucket. Public, not secret.
CMS_DELIVERY_BASE_URL=
# The site's tenant slug. Public, not secret.
CMS_TENANT=
# The site's webhook secrets, comma-separated (two during rotation). SECRET.
CMS_WEBHOOK_SECRETS=
# Host of the `media-public` bucket's public URLs, for next/image remotePatterns. Public, not secret.
CMS_MEDIA_HOST=
