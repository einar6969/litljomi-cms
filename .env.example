# Environment variable names (values are never committed).
# Copy to .env.local and fill in locally; .env* files other than .env.example are never committed.
# tools/cli reads the hosted project's values from Einar's /Users/einarzoega/litljomi-cms/.env.production.local.
# Where each value comes from and where it is set: docs/runbooks/production.md, "Environment variables".

# --- CMS app (apps/cms; Vercel project vefstjorn) ---
# Supabase project URL. Public, not secret.
NEXT_PUBLIC_SUPABASE_URL=
# Supabase publishable key. Public, not secret (reaches the browser; RLS and grants protect data).
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Supabase secret key. SECRET. Read only under apps/cms/src/privileged/** and tools/cli.
SUPABASE_SECRET_KEY=
# Internal worker-trigger secret (header x-cms-internal-secret). SECRET.
CMS_INTERNAL_SECRET=
# Vercel Cron secret (Authorization: Bearer). SECRET.
CRON_SECRET=
# Public base URL of the CMS app, e.g. for magic-link redirects. Public, not secret.
CMS_PUBLIC_URL=
# Alert emails to the platform admin (M3-04). No host: no email (alerts stay in the log and audit log).
# SMTP host, e.g. smtp.sendgrid.net. Public, not secret.
CMS_ALERT_SMTP_HOST=
# SMTP port: 587 (STARTTLS, required off loopback) by default, 465 for implicit TLS. Public, not secret.
CMS_ALERT_SMTP_PORT=
# SMTP user name (SendGrid: apikey). Public, not secret.
CMS_ALERT_SMTP_USER=
# SMTP password (a SendGrid API key with Mail Send only). SECRET.
CMS_ALERT_SMTP_PASSWORD=
# Sender address, verified in SendGrid. Public, not secret.
CMS_ALERT_EMAIL_FROM=
# The platform admin's address(es), comma-separated. Public, not secret.
CMS_ALERT_EMAIL_TO=

# --- Sites (apps/demo-site, Vercel project vefstjorn-demo; the LABAK branch hub-integration, Vercel project labak-hub) ---
# Public URL of the Supabase Storage `delivery` bucket. Public, not secret.
CMS_DELIVERY_BASE_URL=
# The site's tenant slug. Public, not secret.
CMS_TENANT=
# The site's webhook secrets, comma-separated (two during rotation). SECRET.
CMS_WEBHOOK_SECRETS=
# The site's preview secrets, comma-separated. SECRET. The same value is stored in Vault with `provision preview-secret`.
CMS_PREVIEW_SECRETS=
# Origin of the CMS, for its preview endpoint; read only in draft mode. Public, not secret.
CMS_PREVIEW_BASE_URL=
# Host of the `media-public` bucket's public URLs, for next/image remotePatterns. Public, not secret.
CMS_MEDIA_HOST=
# Set to 1 on labak-hub to send X-Robots-Tag: noindex (the demo site always sends it). Public, not secret.
SITE_NOINDEX=
