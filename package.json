{
  "name": "litljomi-cms",
  "private": true,
  "version": "0.0.0",
  "packageManager": "pnpm@11.1.3",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "lint": "eslint -c eslint.config.mjs .",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p apps/cms/tsconfig.json",
    "test": "vitest run",
    "check:slugs": "node tools/checks/no-tenant-slugs.ts",
    "check:schema": "pnpm --filter @litljomi/cli cli check-schema",
    "test:integration": "pnpm --filter @litljomi/integration-tests test && pnpm --filter cms test:integration",
    "test:e2e-local": "pnpm --filter @litljomi/integration-tests test:e2e-local",
    "harness:test": "node --test \"tools/harness/__tests__/*.test.mjs\"",
    "db:start": "SUPABASE_TELEMETRY_DISABLED=1 supabase start",
    "db:stop": "SUPABASE_TELEMETRY_DISABLED=1 supabase stop",
    "db:reset": "SUPABASE_TELEMETRY_DISABLED=1 supabase db reset",
    "db:test": "node tools/db/test.mjs",
    "seed:local": "node tests/integration/scripts/seed-local.ts",
    "seed:labak-site": "node tests/integration/scripts/seed-labak-site.ts"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "eslint": "^9",
    "smol-toml": "^1.9.1",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8",
    "vitest": "^3.2.7"
  }
}
