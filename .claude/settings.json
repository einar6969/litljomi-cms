{
  "permissions": {
    "defaultMode": "auto",
    "allow": [
      "Bash(git *)",
      "Bash(gh *)",
      "Bash(vercel *)",
      "Bash(supabase *)",
      "Bash(pnpm *)"
    ],
    "deny": [
      "Read(/.env)",
      "Read(/.env.local)",
      "Read(/.env.*.local)",
      "Read(/**/.env)",
      "Read(/**/.env.local)",
      "Read(/**/.env.*.local)",
      "Edit(/.env)",
      "Edit(/.env.local)",
      "Edit(/.env.*.local)",
      "Edit(/**/.env)",
      "Edit(/**/.env.local)",
      "Edit(/**/.env.*.local)",
      "Write(/.env)",
      "Write(/.env.local)",
      "Write(/.env.*.local)",
      "Write(/**/.env)",
      "Write(/**/.env.local)",
      "Write(/**/.env.*.local)"
    ],
    "ask": [
      "Bash(supabase db reset --linked*)",
      "Bash(supabase config push*)",
      "Bash(supabase migration repair*)",
      "Bash(pnpm exec supabase db reset --linked*)",
      "Bash(pnpm exec supabase config push*)",
      "Bash(pnpm exec supabase migration repair*)",
      "Bash(npx supabase db reset --linked*)",
      "Bash(npx supabase config push*)",
      "Bash(npx supabase migration repair*)"
    ]
  },
  "sandbox": {
    "enabled": false
  }
}
