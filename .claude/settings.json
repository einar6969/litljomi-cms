{
  "permissions": {
    "defaultMode": "acceptEdits",
    "disableBypassPermissionsMode": "disable",
    "allow": [
      "Bash(git *)",
      "Bash(gh *)"
    ],
    "deny": [
      "Bash(sudo *)",
      "Read(/.env)",
      "Read(/.env.local)",
      "Read(/**/.env)",
      "Read(/**/.env.local)",
      "Edit(/.env)",
      "Edit(/.env.local)",
      "Edit(/**/.env)",
      "Edit(/**/.env.local)",
      "Write(/.env)",
      "Write(/.env.local)",
      "Write(/**/.env)",
      "Write(/**/.env.local)",
      "Read(/.env.staging.local)",
      "Read(/**/.env.staging.local)",
      "Edit(/.env.staging.local)",
      "Edit(/**/.env.staging.local)",
      "Write(/.env.staging.local)",
      "Write(/**/.env.staging.local)",
      "Bash(git push * staging*)",
      "Bash(git push *:staging*)",
      "Bash(git -C * push * staging*)",
      "Bash(git -C * push *:staging*)"
    ],
    "ask": [
      "Bash(vercel *)",
      "Bash(netlify *)",
      "Bash(supabase link *)",
      "Bash(supabase login *)",
      "Bash(supabase db push *)",
      "Bash(supabase projects *)",
      "Bash(supabase orgs *)",
      "Bash(supabase secrets *)",
      "Bash(supabase functions deploy *)",
      "Bash(supabase config push *)",
      "Bash(supabase db reset --linked *)",
      "Bash(supabase migration repair *)",
      "Bash(npm publish *)",
      "Bash(pnpm publish *)",
      "Bash(brew *)",
      "Edit(/.claude/**)"
    ]
  },
  "sandbox": {
    "enabled": true,
    "failIfUnavailable": true,
    "excludedCommands": [
      "gh *",
      "git *"
    ],
    "network": {
      "allowedDomains": [
        "registry.npmjs.org"
      ],
      "allowUnixSockets": [
        "/Users/einarzoega/.orbstack/run/docker.sock",
        "/var/run/docker.sock"
      ],
      "allowLocalBinding": true
    }
  }
}
