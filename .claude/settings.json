{
  "permissions": {
    "defaultMode": "acceptEdits",
    "disableBypassPermissionsMode": "disable",
    "allow": [
      "Bash(git status*)",
      "Bash(git log*)",
      "Bash(git diff)",
      "Bash(git diff *)",
      "Bash(git show*)",
      "Bash(git rev-parse *)",
      "Bash(git merge-base *)",
      "Bash(git ls-files*)",
      "Bash(git for-each-ref*)",
      "Bash(git worktree list*)",
      "Bash(git branch --show-current)",
      "Bash(git branch --list*)",
      "Bash(git fetch origin)",
      "Bash(git fetch --prune origin)"
    ],
    "deny": [
      "Bash(sudo *)",
      "Read(/.env)",
      "Read(/.env.local)",
      "Read(/**/.env)",
      "Read(/**/.env.local)",
      "Edit(/.env)",
      "Edit(/.env.local)",
      "Edit(/**/.env)",
      "Edit(/**/.env.local)",
      "Write(/.env)",
      "Write(/.env.local)",
      "Write(/**/.env)",
      "Write(/**/.env.local)",
      "Read(/.env.staging.local)",
      "Read(/**/.env.staging.local)",
      "Edit(/.env.staging.local)",
      "Edit(/**/.env.staging.local)",
      "Write(/.env.staging.local)",
      "Write(/**/.env.staging.local)"
    ],
    "ask": [
      "Bash(git push *)",
      "Bash(git remote *)",
      "Bash(git -C * push *)",
      "Bash(git -C * remote *)",
      "Bash(gh *)",
      "Bash(git pull *)",
      "Bash(git fetch *--upload-pack*)",
      "Bash(git log *--output*)",
      "Bash(git diff *--output*)",
      "Bash(git show *--output*)",
      "Bash(git diff *--no-index*)",
      "Bash(vercel *)",
      "Bash(netlify *)",
      "Bash(supabase link *)",
      "Bash(supabase login *)",
      "Bash(supabase db push *)",
      "Bash(supabase projects *)",
      "Bash(supabase orgs *)",
      "Bash(supabase secrets *)",
      "Bash(supabase functions deploy *)",
      "Bash(supabase config push *)",
      "Bash(supabase db reset --linked *)",
      "Bash(supabase migration repair *)",
      "Bash(npm publish *)",
      "Bash(pnpm publish *)",
      "Bash(brew *)",
      "Edit(/.claude/**)"
    ]
  },
  "sandbox": {
    "enabled": true,
    "failIfUnavailable": true,
    "excludedCommands": [
      "gh *",
      "git fetch *",
      "git pull *",
      "git push *"
    ],
    "network": {
      "allowedDomains": ["registry.npmjs.org"],
      "allowUnixSockets": [
        "/Users/einarzoega/.orbstack/run/docker.sock",
        "/var/run/docker.sock"
      ],
      "allowLocalBinding": true
    }
  }
}
