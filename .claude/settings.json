{
  "permissions": {
    "defaultMode": "acceptEdits",
    "disableBypassPermissionsMode": "disable",
    "allow": [
      "Bash(git status*)",
      "Bash(git log*)",
      "Bash(git diff*)",
      "Bash(git show*)",
      "Bash(git blame *)",
      "Bash(git rev-parse *)",
      "Bash(git rev-list *)",
      "Bash(git merge-base *)",
      "Bash(git ls-files*)",
      "Bash(git for-each-ref*)",
      "Bash(git worktree list*)",
      "Bash(git branch --show-current)",
      "Bash(git branch --list*)",
      "Bash(git fetch origin)",
      "Bash(git fetch --prune origin)",
      "Bash(gh auth status)",
      "Bash(gh repo view *)",
      "Bash(gh pr list *)",
      "Bash(gh pr view *)",
      "Bash(gh pr diff *)",
      "Bash(gh pr checks *)",
      "Bash(gh run list *)",
      "Bash(gh run view *)"
    ],
    "deny": [
      "Bash(sudo *)",
      "Read(/.env)",
      "Read(/.env.local)",
      "Read(/**/.env)",
      "Read(/**/.env.local)",
      "Edit(/.env)",
      "Edit(/.env.local)",
      "Edit(/**/.env)",
      "Edit(/**/.env.local)",
      "Write(/.env)",
      "Write(/.env.local)",
      "Write(/**/.env)",
      "Write(/**/.env.local)",
      "Read(/.env.staging.local)",
      "Read(/**/.env.staging.local)",
      "Edit(/.env.staging.local)",
      "Edit(/**/.env.staging.local)",
      "Write(/.env.staging.local)",
      "Write(/**/.env.staging.local)"
    ],
    "ask": [
      "Bash(git push *)",
      "Bash(git remote *)",
      "Bash(git -C * push *)",
      "Bash(git -C * remote *)",
      "Bash(gh pr *merge*)",
      "Bash(gh pr *create*)",
      "Bash(gh pr *close*)",
      "Bash(gh pr *edit*)",
      "Bash(gh pr *comment*)",
      "Bash(gh pr *review*)",
      "Bash(gh pr *ready*)",
      "Bash(gh pr *reopen*)",
      "Bash(gh pr *lock*)",
      "Bash(gh pr *revert*)",
      "Bash(gh pr *update-branch*)",
      "Bash(gh pr *checkout*)",
      "Bash(gh repo edit *)",
      "Bash(gh repo delete *)",
      "Bash(gh repo create *)",
      "Bash(gh repo sync*)",
      "Bash(gh repo fork*)",
      "Bash(gh repo rename*)",
      "Bash(gh repo archive*)",
      "Bash(gh repo unarchive*)",
      "Bash(gh repo autolink*)",
      "Bash(gh repo deploy-key*)",
      "Bash(gh secret *)",
      "Bash(gh variable *)",
      "Bash(gh workflow *)",
      "Bash(gh run rerun *)",
      "Bash(gh run cancel *)",
      "Bash(gh run delete *)",
      "Bash(gh release *)",
      "Bash(gh issue *)",
      "Bash(gh gist *)",
      "Bash(gh label *)",
      "Bash(gh cache *)",
      "Bash(gh project *)",
      "Bash(gh ssh-key *)",
      "Bash(gh gpg-key *)",
      "Bash(gh codespace *)",
      "Bash(gh config *)",
      "Bash(gh alias *)",
      "Bash(gh extension *)",
      "Bash(gh auth login*)",
      "Bash(gh auth logout*)",
      "Bash(gh auth refresh*)",
      "Bash(gh auth token*)",
      "Bash(gh auth switch*)",
      "Bash(gh auth setup-git*)",
      "Bash(gh auth git-credential*)",
      "Bash(gh auth status *-t*)",
      "Bash(gh api *)",
      "Bash(git pull *)",
      "Bash(git fetch *--upload-pack*)",
      "Bash(git log *--output*)",
      "Bash(git diff *--output*)",
      "Bash(git show *--output*)",
      "Bash(git diff *--no-index*)",
      "Bash(git blame *--contents*)",
      "Bash(vercel *)",
      "Bash(netlify *)",
      "Bash(supabase link *)",
      "Bash(supabase login *)",
      "Bash(supabase db push *)",
      "Bash(supabase projects *)",
      "Bash(supabase orgs *)",
      "Bash(supabase secrets *)",
      "Bash(supabase functions deploy *)",
      "Bash(supabase config push *)",
      "Bash(supabase db reset --linked *)",
      "Bash(supabase migration repair *)",
      "Bash(npm publish *)",
      "Bash(pnpm publish *)",
      "Bash(brew *)",
      "Edit(/.claude/**)"
    ]
  },
  "sandbox": {
    "enabled": true,
    "failIfUnavailable": true,
    "excludedCommands": [
      "gh *",
      "git fetch *",
      "git pull *",
      "git push *"
    ],
    "network": {
      "allowedDomains": ["registry.npmjs.org"],
      "allowUnixSockets": [
        "/Users/einarzoega/.orbstack/run/docker.sock",
        "/var/run/docker.sock"
      ],
      "allowLocalBinding": true
    }
  }
}
