{
  "permissions": {
    "defaultMode": "acceptEdits",
    "disableBypassPermissionsMode": "disable",
    "deny": [
      "Bash(sudo *)",
      "Read(/.env)",
      "Read(/.env.local)",
      "Read(/**/.env)",
      "Read(/**/.env.local)",
      "Edit(/.env)",
      "Edit(/.env.local)",
      "Edit(/**/.env)",
      "Edit(/**/.env.local)",
      "Write(/.env)",
      "Write(/.env.local)",
      "Write(/**/.env)",
      "Write(/**/.env.local)"
    ],
    "ask": [
      "Bash(git push *)",
      "Bash(git remote *)",
      "Bash(git -C * push *)",
      "Bash(git -C * remote *)",
      "Bash(gh *)",
      "Bash(vercel *)",
      "Bash(netlify *)",
      "Bash(supabase link *)",
      "Bash(supabase login *)",
      "Bash(supabase db push *)",
      "Bash(supabase projects *)",
      "Bash(supabase orgs *)",
      "Bash(supabase secrets *)",
      "Bash(supabase functions deploy *)",
      "Bash(supabase config push *)",
      "Bash(supabase db reset --linked *)",
      "Bash(supabase migration repair *)",
      "Bash(npm publish *)",
      "Bash(pnpm publish *)",
      "Bash(brew *)",
      "Edit(/.claude/**)"
    ]
  },
  "sandbox": {
    "enabled": true,
    "failIfUnavailable": true,
    "network": {
      "allowedDomains": ["registry.npmjs.org"],
      "allowUnixSockets": [
        "/Users/einarzoega/.orbstack/run/docker.sock",
        "/var/run/docker.sock"
      ],
      "allowLocalBinding": true
    }
  }
}
